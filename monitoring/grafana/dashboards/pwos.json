{
  "uid": "pwos",
  "title": "PWOS Monitoring",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Servers up (1 = up)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "up{job=\"pwos\"}", "legendFormat": "{{server}}" } ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute",
        "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } } },
    { "id": 2, "type": "stat", "title": "Server errors (5xx) in the last hour",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(increase(http_server_requests_seconds_count{status=~\"5..\"}[1h])) or vector(0)" } ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute",
        "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } } },
    { "id": 3, "type": "timeseries", "title": "Requests per second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (server) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{server}}" } ] },
    { "id": 4, "type": "timeseries", "title": "Average response time (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "1000 * sum by (server) (rate(http_server_requests_seconds_sum[1m])) / sum by (server) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{server}}" } ] },
    { "id": 5, "type": "timeseries", "title": "JVM heap used (MB)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (server) (jvm_memory_used_bytes{area=\"heap\"}) / 1024 / 1024", "legendFormat": "{{server}}" } ] },
    { "id": 6, "type": "timeseries", "title": "Active database connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (server) (hikaricp_connections_active)", "legendFormat": "{{server}}" } ] }
  ]
}
